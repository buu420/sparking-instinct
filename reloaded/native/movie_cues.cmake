# Generate the native timeline from the user-authored cue sheet at configure time.
set(narration_dir "${CMAKE_CURRENT_LIST_DIR}/../narration")
set(cue_sheet "${narration_dir}/cue-sheet.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${cue_sheet}")
file(READ "${cue_sheet}" cue_json)
string(JSON film_count LENGTH "${cue_json}" films)
if(NOT film_count EQUAL 2)
    message(FATAL_ERROR "Expected the two narrated opening films in ${cue_sheet}.")
endif()

set(cue_cpp "// Generated from the packaged cue sheet.\n")
set(film_cpp "constexpr MovieSchedule schedules[] = {\n")
foreach(film_index RANGE 0 1)
    string(JSON film GET "${cue_json}" films ${film_index})
    string(JSON movie GET "${film}" movie)
    string(JSON alias_count LENGTH "${film}" aliases)
    string(JSON fps GET "${film}" fps)
    string(JSON frames GET "${film}" totalFrames)
    string(JSON margin GET "${film}" polling_margin)
    string(JSON cue_count LENGTH "${film}" cues)
    if(NOT movie MATCHES "^Korat_OP([23])_1K_CP\\.usm$" OR
       NOT alias_count EQUAL 2 OR NOT fps EQUAL 30 OR cue_count LESS 1)
        message(FATAL_ERROR "Unexpected narration schedule for ${movie}.")
    endif()
    string(SUBSTRING "${movie}" 8 1 film_number)
    string(JSON alias_2k GET "${film}" aliases 0)
    string(JSON alias_4k GET "${film}" aliases 1)
    if(NOT alias_2k STREQUAL "Korat_OP${film_number}_2K_CP.usm" OR
       NOT alias_4k STREQUAL "Korat_OP${film_number}_4K_CP.usm")
        message(FATAL_ERROR "Unexpected resolution aliases for ${movie}.")
    endif()
    string(APPEND cue_cpp
           "constexpr std::string_view aliases_${film_index}[] = {\"${movie}\", \"${alias_2k}\", \"${alias_4k}\"};\n"
           "constexpr MovieCue cues_${film_index}[] = {\n")
    math(EXPR last_cue "${cue_count} - 1")
    foreach(cue_index RANGE 0 ${last_cue})
        string(JSON cue GET "${film}" cues ${cue_index})
        string(JSON relative_path GET "${cue}" file)
        if(NOT relative_path MATCHES "^AudioDescription/(op${film_number}-[0-9][0-9]\\.wav)$")
            message(FATAL_ERROR "Unexpected narration clip path ${relative_path}.")
        endif()
        set(filename "${CMAKE_MATCH_1}")
        set(wav "${narration_dir}/${filename}")
        string(JSON expected_hash GET "${cue}" sha256)
        file(SHA256 "${wav}" actual_hash)
        if(NOT actual_hash STREQUAL expected_hash)
            message(FATAL_ERROR "Narration clip hash differs from the cue sheet for ${filename}.")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${wav}")
        string(JSON start GET "${cue}" start)
        string(JSON end GET "${cue}" end)
        string(JSON duration GET "${cue}" duration)
        string(APPEND cue_cpp "    {\"${filename}\", ms(${start}), ms(${end}), ms(${duration})},\n")
    endforeach()
    string(APPEND cue_cpp "};\n")
    string(APPEND film_cpp "    {aliases_${film_index}, ${fps}, ${frames}, ms(${margin}), cues_${film_index}},\n")
endforeach()
string(APPEND cue_cpp "${film_cpp}};\n")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/movie_cues.inc"
     CONTENT "${cue_cpp}" @ONLY NEWLINE_STYLE UNIX)
